# ArcFlow production environment template.
# Copy to .env, fill in every value, chmod 600. NEVER commit the real .env.
# On the existing VPS keep your current .env; only ADD any keys missing from here.

APP_NAME=ArcFlow
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.example
# php artisan key:generate --show   (changing this makes stored xpubs undecryptable!)
APP_KEY=
LOG_LEVEL=info

# Host loopback bind for nginx (reverse-proxy your domain to this)
ARCFLOW_HTTP_BIND=127.0.0.1:4173

# PostgreSQL (compose service "postgres")
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=arcflow
DB_USERNAME=arcflow
DB_PASSWORD=
# Used by the postgres container only when the data volume is first created.
ARCFLOW_POSTGRES_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true

# Required: webhooks are NOT sent if this is empty.
WEBHOOK_SIGNING_SECRET=

# Arc network - verify every value against current official Arc docs before deploying.
ARC_NETWORK=mainnet
ARC_RPC_URL=
# Decimal chain ID. The monitor refuses to scan if this is unset or differs from the RPC's eth_chainId.
ARC_CHAIN_ID=
ARC_USDC_CONTRACT=
ARC_EXPLORER_URL=
ARC_REQUIRED_CONFIRMATIONS=1
# Only used when there is NO saved cursor (fresh DB). Existing deployments keep their cursor.
ARC_START_BLOCK=
BLOCKCHAIN_MODE=arc_mainnet
